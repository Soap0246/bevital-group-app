# Copy to .env (never commit .env). Only EXPO_PUBLIC_* values are bundled into the app, so
# NEVER put a service-role key or any secret here — the anon key is safe by design (RLS protects data).

# Supabase (local: `npx supabase start` prints these)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google Maps / Geocoding key (restrict by bundle id + API). Without it the app uses the
# device geocoder (expo-location) for address search.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Feature flags
EXPO_PUBLIC_PHONE_AUTH_ENABLED=false

# EAS project id, required for remote push notifications on device builds
EXPO_PUBLIC_EAS_PROJECT_ID=

# Demo mode (TEST builds only): shows "Try the demo" buttons so testers and stakeholders can enter without
# typing credentials. The logins are bundled into the app, so use throw-away accounts on a test project and
# NEVER enable this on a project with real patient data. Leave DEMO_MODE unset/false for production.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_DEMO_PATIENT_EMAIL=
EXPO_PUBLIC_DEMO_PATIENT_PASSWORD=
EXPO_PUBLIC_DEMO_PHYSIO_EMAIL=
EXPO_PUBLIC_DEMO_PHYSIO_PASSWORD=
